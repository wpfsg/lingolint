# LingoLint environment variables.
#
# None of these are required. Deterministic checks (missing keys, placeholders,
# HTML tags, whitespace, length, ...) run fully offline with no configuration.
#
# Copy this file to `.env` and fill in a key only if you want optional AI review
# (`lingolint scan --ai`). Never commit `.env`.

# Anthropic API key, used by the built-in "anthropic" AI provider.
# Using AI review sends translation text to the configured AI provider.
ANTHROPIC_API_KEY=

# Optional: override the model used for AI review.
# LINGOLINT_AI_MODEL=

# Optional: disable the on-disk AI response cache (defaults to enabled).
# LINGOLINT_AI_CACHE=0

# Set to any value to disable colored CLI output (standard convention).
# NO_COLOR=1
